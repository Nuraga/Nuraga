DATABASE_URL="postgresql://detsad:detsad@localhost:5432/detsad_crm?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access"
JWT_ACCESS_TTL="15m"
# Refresh tokens are opaque random strings (hash stored in DB), not JWTs —
# JWT_REFRESH_TTL controls their expiry window.
JWT_REFRESH_TTL="30d"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY="change-me-32-byte-base64-key"
FILE_URL_SECRET="change-me-file-url-secret"

# Local-disk object storage adapter (dev). Swap to the S3/MinIO adapter for
# prod-like envs without touching DocumentsService (see common/storage).
OBJECT_STORAGE_LOCAL_ROOT="storage/local"

OBJECT_STORAGE_ENDPOINT="localhost"
OBJECT_STORAGE_PORT="9000"
OBJECT_STORAGE_USE_SSL="false"
OBJECT_STORAGE_ACCESS_KEY="detsad"
OBJECT_STORAGE_SECRET_KEY="detsad12345"
OBJECT_STORAGE_BUCKET="detsad-documents"

PORT="3000"
