# Продовый чек-лист .env — apps/api
#
# Скопируйте в .env на боевом сервере и заполните реальными значениями.
# НИКОГДА не коммитьте заполненный файл в git (он уже в .gitignore как .env).
# Каждый секрет ниже — свой собственный, не переиспользуйте один и тот же
# случайный ключ для нескольких переменных: протечка одного не должна
# автоматически компрометировать остальные (см. комментарий в token.service.ts
# про раздельные секреты access/device/checkin).

# --- База данных -------------------------------------------------------
# Боевой Postgres, НЕ localhost из docker-compose.yml для разработки.
# Обязательно: сильный пароль, доступ только с адреса приложения (не 0.0.0.0/0).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/detsad_crm?schema=public"

# Зарезервировано под фоновые задачи (BullMQ) — на момент этого коммита
# ещё нигде в коде не используется (README упоминает как план, не факт).
# Можно оставить пустым для пилота на одном филиале без потери функциональности.
REDIS_URL="redis://HOST:6379"

# --- JWT-секреты ---------------------------------------------------------
# Сгенерировать каждый: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Три РАЗНЫХ секрета — access-токен сотрудника, токен устройства-киоска и
# токен ротации QR отметки прихода/ухода не должны быть взаимозаменяемы.
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

JWT_DEVICE_SECRET=""
JWT_DEVICE_TTL="180d"

JWT_CHECKIN_SECRET=""

# --- Шифрование медданных и подписанных ссылок на файлы -----------------
# FIELD_ENCRYPTION_KEY шифрует ChildMedical.allergiesEnc/chronicEnc/... —
# потеря этого ключа делает мед. данные детей нечитаемыми НАВСЕГДА.
# Сохраните резервную копию в отдельном защищённом месте (не в этом .env,
# не в общем бэкапе БД, не в системе тикетов).
# Генерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# Подписывает короткоживущие (5 мин) ссылки на скачивание файлов — можно
# сгенерировать так же, как выше, отдельным значением.
FILE_URL_SECRET=""

# --- Файловое хранилище ---------------------------------------------------
# РЕШИТЬ ПЕРЕД ЗАПУСКОМ: сейчас в коде реализован только адаптер локального
# диска (LocalDiskObjectStorage) — переменные OBJECT_STORAGE_ENDPOINT и
# другие S3/MinIO-параметры в этом .env.example НЕ подключены ни к какому
# клиенту, несмотря на то что MinIO поднимается в docker-compose.yml.
# Для пилота на одном филиале локальный диск — приемлемо, НО:
#   - файлы не переживут пересоздание контейнера/сервера без volume-бэкапа;
#   - при нескольких инстансах приложения (масштабирование) сломается.
# Если это не устраивает — нужно сначала реализовать S3/MinIO-адаптер
# (интерфейс уже готов в common/storage/object-storage.interface.ts).
OBJECT_STORAGE_LOCAL_ROOT="/var/lib/detsad-crm/storage"

# --- Сеть -------------------------------------------------------------
PORT="3000"

# Сузить CORS до реального домена фронтенда (см. пункт 2 ниже). Через
# запятую, если фронтенд отвечает на нескольких origin.
CORS_ORIGIN="https://ваш-домен"

# ---------------------------------------------------------------------
# НЕ переменные .env, но обязательны к решению перед запуском:
#
# 1. Реверс-прокси — РЕШЕНО (см. docker-compose.prod.yml + apps/web/Caddyfile,
#    DEPLOY.md): Caddy отдаёт "/" → статика apps/web, "/api" → этот бэкенд,
#    оба с одного домена.
# 2. CORS — РЕШЕНО: main.ts теперь читает CORS_ORIGIN (см. выше). Не забыть
#    заполнить реальным доменом перед запуском.
# 3. HTTPS/TLS — РЕШЕНО: Caddy сам получает и продлевает сертификат Let's
#    Encrypt (см. DEPLOY.md) — при условии, что DNS домена уже указывает на
#    сервер до первого запуска контейнера.
# 4. Регулярный бэкап Postgres + каталога OBJECT_STORAGE_LOCAL_ROOT —
#    всё ещё НЕ автоматизировано (docker-compose.prod.yml просто держит их в
#    volume'ах postgres_data/api_storage — переживают перезапуск контейнера,
#    но не диска сервера). Настроить cron с pg_dump — см. DEPLOY.md.
# 5. 2FA — включить фактически для OWNER/ACCOUNTANT/SUPERADMIN аккаунтов
#    после первого логина (система поддерживает, но не принуждает).
# 6. Дефолтный пароль superadmin из сида ("ChangeMe123!") — сменить сразу
#    после первого логина, если система доступна из интернета (демо — не
#    исключение: чужой логин под сидовым паролем всё равно нежелателен).
