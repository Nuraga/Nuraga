// Stage 1 MVP schema — core records module only.
// Billing (tariff/contract/invoice/payment), leads, messaging, and consent
// entities are intentionally not modeled yet (Stage 2-4 of the TRD roadmap).

generator client {
  provider = "prisma-client-js"
  // "native" = local dev (Windows/mac/glibc-linux). linux-musl-openssl-3.0.x
  // is required for the Alpine-based Docker image (apps/api/Dockerfile) —
  // confirmed by testing the built image: without it, PrismaClient fails at
  // boot with "could not locate the Query Engine for runtime
  // linux-musl-openssl-3.0.x" even though `prisma generate` itself succeeds.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  OWNER
  BRANCH_MANAGER
  MANAGER
  ACCOUNTANT
  TEACHER
  // Assists teachers; no group/child-data access — clocks in/out via kiosk
  // QR and receives tasks from a METHODIST or заведующий (BRANCH_MANAGER).
  NANNY
  // Oversees TEACHER/NANNY staff within a branch: assigns them tasks and
  // monitors their kiosk attendance. Deliberately NOT in STAFF_MANAGER_ROLES
  // (staff.service.ts) — hiring/firing stays with OWNER/BRANCH_MANAGER.
  METHODIST
  PARENT
}

model User {
  id                String   @id @default(uuid())
  email             String?  @unique
  phone             String?  @unique
  passwordHash      String
  fullName          String
  totpSecret        String?
  totpEnabled       Boolean  @default(false)
  isActive          Boolean  @default(true)
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branchRoles       UserBranchRole[]
  parentProfile     Parent?
  staffProfile      Staff?
  refreshTokens     RefreshToken[]
  auditLogEntries   AuditLog[]
  uploadedPhotos    Photo[]
  notifications     Notification[]

  @@map("user")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_token")
}

// One row per (user, branch, role) grant. A user can hold different roles in
// different branches; effective permissions are the union of all grants.
model UserBranchRole {
  id       String @id @default(uuid())
  userId   String
  branchId String
  role     Role

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId, role])
  @@index([branchId])
  @@map("user_branch_role")
}

// ---------------------------------------------------------------------------
// Branches, groups
// ---------------------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  locale    String   @default("ru")
  timezone  String   @default("UTC")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles        UserBranchRole[]
  groups           Group[]
  families         Family[]
  waitlistEntries  WaitlistEntry[]
  timesheetPeriods TimesheetPeriod[]
  staff            Staff[]
  tariffs          Tariff[]
  services         Service[]
  invoices         Invoice[]
  payments         Payment[]
  leads            Lead[]
  tasks            Task[]
  devices              Device[]
  staffAttendanceEvents StaffAttendanceEvent[]
  menuItems             MenuItem[]
  photos                Photo[]
  shifts                Shift[]
  staffVacations        StaffVacation[]

  @@map("branch")
}

model GroupType {
  id            String  @id @default(uuid())
  name          String  @unique
  minAgeMonths  Int
  maxAgeMonths  Int
  isActive      Boolean @default(true)

  groups Group[]

  @@map("group_type")
}

model Group {
  id                String   @id @default(uuid())
  branchId          String
  groupTypeId       String
  name              String
  plannedCapacity   Int
  maxCapacity       Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch    Branch    @relation(fields: [branchId], references: [id])
  groupType GroupType @relation(fields: [groupTypeId], references: [id])

  children        Child[]
  waitlistEntries WaitlistEntry[]
  attendances     Attendance[]
  staff           StaffGroup[]
  photos          Photo[]

  @@index([branchId])
  @@map("group")
}

// ---------------------------------------------------------------------------
// Families, children
// ---------------------------------------------------------------------------

model Family {
  id        String   @id @default(uuid())
  branchId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id])
  parents        Parent[]
  children       Child[]
  trustedPersons TrustedPerson[]
  discounts      Discount[]
  contracts      Contract[]
  invoices       Invoice[]
  payments       Payment[]
  tasks          Task[]

  @@index([branchId])
  @@map("family")
}

model Parent {
  id             String  @id @default(uuid())
  familyId       String
  userId         String? @unique
  fullName       String
  relationship   String // "мать", "отец", "опекун", ...
  contactPriority Int    @default(1)
  phone          String?
  email          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  absenceRequests      AbsenceRequest[]
  photoConsentUpdates  ChildPhotoConsent[]

  @@index([familyId])
  @@map("parent")
}

model TrustedPerson {
  id           String    @id @default(uuid())
  familyId     String
  fullName     String
  documentInfo String?
  photoKey     String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("trusted_person")
}

enum ChildStatus {
  WAITLIST
  ENROLLED
  SUSPENDED
  DISCHARGED
}

model Child {
  id             String      @id @default(uuid())
  familyId       String
  groupId        String?
  fullName       String
  birthDate      DateTime
  sex            String?
  photoKey       String?
  status         ChildStatus @default(WAITLIST)
  enrolledAt     DateTime?
  suspendedAt    DateTime?
  discharedAt    DateTime?
  dischargeReasonId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  family          Family           @relation(fields: [familyId], references: [id])
  group           Group?           @relation(fields: [groupId], references: [id])
  dischargeReason DischargeReason? @relation(fields: [dischargeReasonId], references: [id])

  medical         ChildMedical?
  documents       Document[]
  attendances     Attendance[]
  waitlistEntries WaitlistEntry[]
  history         ChildHistoryEntry[]
  serviceEnrollments ServiceEnrollment[]
  discounts       Discount[]
  contracts       Contract[]
  invoiceLines    InvoiceLine[]
  absenceRequests AbsenceRequest[]
  allergens       ChildAllergen[]
  photoConsent    ChildPhotoConsent?

  @@index([familyId])
  @@index([groupId])
  @@map("child")
}

// Sensitive medical fields — encrypted at rest at the application layer
// (see EncryptionService). Teachers only ever see `criticalInfo`.
model ChildMedical {
  id                String  @id @default(uuid())
  childId           String  @unique
  allergiesEnc      String? // encrypted
  chronicEnc        String? // encrypted
  activityLimitsEnc String? // encrypted
  doctorContactEnc  String? // encrypted
  criticalInfo      String? // plain text, teacher-visible summary (allergies/diet only)
  updatedAt         DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("child_medical")
}

// ---------------------------------------------------------------------------
// Menu & nutrition (TRD §7.4) — structured allergy tags live here, separate
// from ChildMedical's encrypted narrative fields: these are low-sensitivity
// tags meant to be cross-referenced against dishes by a wide staff audience
// (including TEACHER), not the narrow-audience encrypted medical detail.
// ---------------------------------------------------------------------------

model Allergen {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  dishes         DishAllergen[]
  childAllergens ChildAllergen[]

  @@map("allergen")
}

model ChildAllergen {
  childId    String
  allergenId String

  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([childId, allergenId])
  @@map("child_allergen")
}

model Dish {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true)

  allergens DishAllergen[]
  menuItems MenuItem[]

  @@map("dish")
}

model DishAllergen {
  dishId     String
  allergenId String

  dish     Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@id([dishId, allergenId])
  @@map("dish_allergen")
}

enum MealType {
  BREAKFAST
  LUNCH
  AFTERNOON_SNACK
}

// One row = one dish within one meal sitting on one day at one branch; a
// sitting can include several dishes (soup + main + compote).
model MenuItem {
  id       String   @id @default(uuid())
  branchId String
  date     DateTime @db.Date
  mealType MealType
  dishId   String

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dish   Dish   @relation(fields: [dishId], references: [id])

  @@index([branchId, date])
  @@map("menu_item")
}

// ---------------------------------------------------------------------------
// Photo feed (Этап 4 leftover — ТЗ §7): a teacher/manager posts photos for
// their group; parents of children in that group see them in a chronological
// feed. Consent is informational only, the same non-blocking pattern as the
// menu module's allergen conflicts (see MenuService.computeConflicts): it
// warns the uploader which children in the group lack consent so they can be
// framed out of the shot, but it never blocks an upload or hides a photo.
// ---------------------------------------------------------------------------

model Photo {
  id           String   @id @default(uuid())
  branchId     String
  groupId      String
  fileKey      String
  fileName     String
  mimeType     String
  caption      String?
  takenAt      DateTime @default(now())
  uploadedById String
  createdAt    DateTime @default(now())

  branch     Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  group      Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([branchId])
  @@index([groupId, takenAt])
  @@map("photo")
}

// One row per child; consent defaults to false (explicit opt-in) and is
// granted/revoked by a parent of the child's family — see
// ParentPortalService.setPhotoConsent. Mirrors ChildMedical's 1:1 shape.
model ChildPhotoConsent {
  id                String   @id @default(uuid())
  childId           String   @unique
  consent           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  updatedByParentId String?

  child           Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  updatedByParent Parent? @relation(fields: [updatedByParentId], references: [id])

  @@map("child_photo_consent")
}

// Effective-dated transfers, suspensions, discharges — append-only.
model ChildHistoryEntry {
  id           String   @id @default(uuid())
  childId      String
  type         String // "transfer" | "suspend" | "resume" | "discharge" | "tariff_change"
  fromGroupId  String?
  toGroupId    String?
  effectiveAt  DateTime
  reason       String?
  actorUserId  String
  createdAt    DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("child_history_entry")
}

enum DocumentOwnerType {
  CHILD
  STAFF
}

model DocumentType {
  id       String  @id @default(uuid())
  name     String  @unique
  hasExpiry Boolean @default(false)
  isActive Boolean @default(true)

  documents Document[]

  @@map("document_type")
}

model Document {
  id             String            @id @default(uuid())
  ownerType      DocumentOwnerType
  ownerId        String
  documentTypeId String
  fileKey        String
  fileName       String
  mimeType       String
  expiresAt      DateTime?
  uploadedById   String
  createdAt      DateTime          @default(now())

  documentType DocumentType @relation(fields: [documentTypeId], references: [id])
  child        Child?       @relation(fields: [ownerId], references: [id], map: "document_child_fk")

  @@index([ownerType, ownerId])
  @@index([expiresAt])
  @@map("document")
}

model DischargeReason {
  id     String  @id @default(uuid())
  name   String  @unique
  isActive Boolean @default(true)

  children Child[]

  @@map("discharge_reason")
}

model WaitlistEntry {
  id         String   @id @default(uuid())
  branchId   String
  groupId    String
  childId    String?
  leadId     String?
  leadName   String?
  priority   Int      @default(0)
  queuedAt   DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])
  group  Group  @relation(fields: [groupId], references: [id])
  child  Child? @relation(fields: [childId], references: [id])
  lead   Lead?  @relation(fields: [leadId], references: [id])

  @@index([branchId, groupId])
  @@map("waitlist_entry")
}

// ---------------------------------------------------------------------------
// Attendance & timesheets
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT_SICK
  ABSENT_EXCUSED
  VACATION
  LATE
  UNMARKED
}

model Attendance {
  id             String            @id @default(uuid())
  childId        String
  groupId        String
  date           DateTime          @db.Date
  status         AttendanceStatus  @default(UNMARKED)
  checkInAt      DateTime?
  checkOutAt     DateTime?
  pickedUpById   String? // Parent.id or TrustedPerson.id
  pickedUpByType String? // "parent" | "trusted_person"
  markedById     String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  child Child @relation(fields: [childId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([childId, date])
  @@index([groupId, date])
  @@map("attendance")
}

enum AbsenceRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ТЗ §5.2/§7.1: a parent-submitted heads-up about an upcoming absence.
// Approval upserts Attendance{status: ABSENT_EXCUSED} for every date in the
// range (mirrors AttendanceService.mark's per-day upsert) — this is the
// only write path into Attendance a parent influences, and always via
// staff review, never directly.
model AbsenceRequest {
  id                  String                @id @default(uuid())
  childId             String
  dateFrom            DateTime              @db.Date
  dateTo              DateTime              @db.Date
  reason              String?
  status              AbsenceRequestStatus  @default(PENDING)
  submittedByParentId String
  reviewedById        String?
  reviewedAt          DateTime?
  reviewComment       String?
  createdAt           DateTime              @default(now())

  child             Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  submittedByParent Parent @relation(fields: [submittedByParentId], references: [id])

  @@index([childId])
  @@map("absence_request")
}

enum TimesheetPeriodStatus {
  OPEN
  CLOSED
}

model TimesheetPeriod {
  id         String                 @id @default(uuid())
  branchId   String
  month      Int
  year       Int
  status     TimesheetPeriodStatus  @default(OPEN)
  closedById String?
  closedAt   DateTime?
  createdAt  DateTime               @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  corrections TimesheetCorrection[]

  @@unique([branchId, year, month])
  @@map("timesheet_period")
}

// Required to edit attendance after a period is closed (invariant #4, TRD 11.3).
model TimesheetCorrection {
  id           String   @id @default(uuid())
  periodId     String
  attendanceId String
  reason       String
  actorUserId  String
  createdAt    DateTime @default(now())

  period TimesheetPeriod @relation(fields: [periodId], references: [id])

  @@map("timesheet_correction")
}

// ---------------------------------------------------------------------------
// Staff (basic level, per TRD module M6)
// ---------------------------------------------------------------------------

model Staff {
  id           String    @id @default(uuid())
  userId       String    @unique
  branchId     String
  position     String
  hiredAt      DateTime?
  // Soft-delete marker: null = currently employed. Set by StaffService.terminate
  // (dismissal) instead of a hard delete, so attendance/shift/audit history
  // stays intact — same reasoning as the isActive flag on dictionary rows,
  // just named for what this row actually represents (an employment span).
  terminatedAt DateTime?
  // "HH:MM" 24h, individually set by OWNER/BRANCH_MANAGER (StaffService.updateSchedule).
  // null = use the network-wide default (see DEFAULT_CHECK_IN_TIME/
  // DEFAULT_CHECK_OUT_TIME in staff-attendance.service.ts).
  expectedCheckInTime  String?
  expectedCheckOutTime String?
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
  groups StaffGroup[]
  attendanceEvents StaffAttendanceEvent[]
  shifts Shift[]
  vacations StaffVacation[]

  @@map("staff")
}

model StaffGroup {
  staffId String
  groupId String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([staffId, groupId])
  @@map("staff_group")
}

// ---------------------------------------------------------------------------
// Staff shift schedule (ТЗ §8 M6: "график смен по филиалу в календарном
// виде, без расчёта зарплаты") — a заведующий-planned schedule of who
// works when, separate from StaffAttendanceEvent below (which is what
// actually happened via kiosk QR check-in/out, not what was planned).
// startTime/endTime are plain "HH:MM" strings, not DateTime — this is a
// display-only calendar, no payroll/duration math is computed from it.
// ---------------------------------------------------------------------------

model Shift {
  id          String   @id @default(uuid())
  branchId    String
  staffId     String
  date        DateTime @db.Date
  startTime   String
  endTime     String
  note        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([branchId, date])
  @@map("shift")
}

// ---------------------------------------------------------------------------
// Kiosk QR check-in for staff attendance (заведующий/OWNER provisions one
// Device per branch entrance; staff show a short-lived rotating QR from
// their own phone; the device — never a human — scans it). A Device is
// deliberately NOT a Role/User: it's a single-branch, single-purpose
// credential that must never inherit human management permissions just by
// sitting in the same auth machinery, and it must never be conflated with
// AuthenticatedUser (see DeviceAuthGuard).
// ---------------------------------------------------------------------------

model Device {
  id         String    @id @default(uuid())
  branchId   String
  name       String
  secretHash String
  revokedAt  DateTime?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  branch Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  events StaffAttendanceEvent[]

  @@index([branchId])
  @@map("device")
}

enum StaffAttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum StaffAttendanceEventSource {
  QR
  MANUAL_CORRECTION
}

// Append-only log of raw scan events (not a single upserted per-day row like
// Attendance) — worked hours are always derived on the fly by pairing
// consecutive CHECK_IN/CHECK_OUT events per staff per day, so there is only
// one source of truth to keep in sync.
model StaffAttendanceEvent {
  id               String                      @id @default(uuid())
  staffId          String
  branchId         String
  type             StaffAttendanceEventType
  source           StaffAttendanceEventSource
  occurredAt       DateTime
  deviceId         String?
  correctionReason String?
  correctionById   String?
  createdAt        DateTime                    @default(now())

  staff  Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id])

  @@index([staffId, occurredAt])
  @@index([branchId, occurredAt])
  @@map("staff_attendance_event")
}

// Manager-declared vacation window (StaffService.addVacation/removeVacation,
// OWNER/BRANCH_MANAGER only). While "today" falls within one, the staff
// member shows "В отпуске" instead of a kiosk-attendance status.
model StaffVacation {
  id          String   @id @default(uuid())
  staffId     String
  branchId    String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("staff_vacation")
}

// ---------------------------------------------------------------------------
// Audit log — append-only, never updated/deleted from the app layer.
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  entity     String
  entityId   String
  action     String // "create" | "update" | "delete"
  oldValue   Json?
  newValue   Json?
  actorId    String?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

enum NotificationType {
  STAFF_LATE_CHECK_IN
}

// In-app only (bell icon in AppLayout) — no email/SMS/push infra in this
// project (see DEPLOY.md). Read/unread is per-recipient User.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Billing (Этап 2 ТЗ, раздел 6) — tariffs, services, discounts, contracts,
// invoicing, payments. Money is always integer minor units (тиын/cents);
// floating point is forbidden here per ТЗ §11.1. Approved invoices and
// recorded payments are immutable — corrections happen via new adjustment
// rows, never in-place edits (ТЗ §11.1, §6.4).
// ---------------------------------------------------------------------------

enum TariffType {
  MONTHLY_FULL
  MONTHLY_HALF_DAY
  HOURLY
  PAY_AS_YOU_GO
  DUTY_GROUP
}

enum RecurrencePeriod {
  MONTHLY
  ONE_TIME
  PER_VISIT
}

enum RecalcRule {
  NONE
  MEALS_ONLY
  FULL_DAY_WITH_THRESHOLD
}

// A row is one immutable tariff *version* (ТЗ §6.1: "тарифы версионируются").
// Changing a price means creating a new Tariff row with its own validFrom
// and closing the previous version's validTo — never editing baseAmountMinor
// on a version a Contract already points to, since that would silently
// change the basis for already-generated invoices.
model Tariff {
  id                  String            @id @default(uuid())
  branchId            String? // null = сеть целиком (network-wide tariff)
  name                String
  type                TariffType
  baseAmountMinor     Int
  currency            String            @default("KZT")
  recurrence          RecurrencePeriod
  recalcRule          RecalcRule        @default(NONE)
  recalcThresholdDays Int? // e.g. "recalculated from the 4th sick day" (ТЗ §6.1)
  includesDescription String? // "что включено": meals, nap, base activities
  validFrom           DateTime
  validTo             DateTime?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  branch    Branch?    @relation(fields: [branchId], references: [id])
  contracts Contract[]

  @@index([branchId])
  @@map("tariff")
}

model Service {
  id           String   @id @default(uuid())
  branchId     String
  name         String
  priceMinor   Int
  scheduleInfo String? // free text (e.g. "Пн/Ср/Пт, 16:00") — no full scheduling module yet
  capacity     Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  branch      Branch               @relation(fields: [branchId], references: [id])
  enrollments ServiceEnrollment[]
  invoiceLines InvoiceLine[]

  @@index([branchId])
  @@map("service")
}

model ServiceEnrollment {
  id        String    @id @default(uuid())
  childId   String
  serviceId String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())

  child   Child   @relation(fields: [childId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([childId])
  @@index([serviceId])
  @@map("service_enrollment")
}

enum DiscountBasis {
  SECOND_CHILD
  PREPAYMENT
  CORPORATE
  STAFF
  SOCIAL
  DIRECTOR_DECISION
}

enum DiscountKind {
  PERCENT
  FIXED_AMOUNT
}

// Family-wide (familyId set) or single-child (childId set) — exactly one of
// the two, enforced at the service layer. DIRECTOR_DECISION requires a
// mandatory reason and Owner/Branch Manager approval (ТЗ §6.3 — flagged as
// "типичная зона финансовых утечек", so it gets its own audit visibility).
model Discount {
  id           String        @id @default(uuid())
  familyId     String?
  childId      String?
  basis        DiscountBasis
  kind         DiscountKind
  value        Int // percent (0-100) for PERCENT, minor units for FIXED_AMOUNT
  reason       String?
  validFrom    DateTime
  validTo      DateTime?
  approvedById String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())

  family Family? @relation(fields: [familyId], references: [id])
  child  Child?  @relation(fields: [childId], references: [id])

  @@index([familyId])
  @@index([childId])
  @@map("discount")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
  EXPIRED
}

model Contract {
  id        String         @id @default(uuid())
  familyId  String
  childId   String
  tariffId  String
  number    String         @unique
  startDate DateTime
  endDate   DateTime?
  status    ContractStatus @default(DRAFT)
  fileKey   String? // scanned signed document, same object-storage pattern as Document
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  family Family @relation(fields: [familyId], references: [id])
  child  Child  @relation(fields: [childId], references: [id])
  tariff Tariff @relation(fields: [tariffId], references: [id])

  @@index([familyId])
  @@index([childId])
  @@map("contract")
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// One per (family, branch, year, month). Draft while the month-close review
// is in progress; APPROVED freezes it (ТЗ §6.4: "после утверждения счёт
// неизменяем — правки только через корректирующий документ").
model Invoice {
  id           String        @id @default(uuid())
  familyId     String
  branchId     String
  year         Int
  month        Int
  status       InvoiceStatus @default(DRAFT)
  totalMinor   Int           @default(0)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  family Family @relation(fields: [familyId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  lines       InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([familyId, year, month])
  @@index([branchId, year, month])
  @@map("invoice")
}

enum InvoiceLineType {
  TARIFF
  SERVICE
  FINE
  RECALC
  DISCOUNT
  MANUAL_ADJUSTMENT
  PREVIOUS_BALANCE
}

// amountMinor is signed — negative for discounts/recalculations/credits.
// ruleRef captures *why* the line exists (which tariff/discount/attendance
// data produced it) so a parent-facing breakdown is always explainable
// (ТЗ §6: "по каждой строке счёта родитель должен видеть, откуда взялась сумма").
model InvoiceLine {
  id          String          @id @default(uuid())
  invoiceId   String
  childId     String?
  serviceId   String?
  type        InvoiceLineType
  description String
  amountMinor Int
  ruleRef     String?
  createdAt   DateTime        @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  child   Child?   @relation(fields: [childId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_line")
}

enum PaymentMethod {
  CASH
  CARD_ONSITE
  BANK_TRANSFER
  ONLINE_GATEWAY
}

// Immutable once created (ТЗ §11.1) — refunds are a separate operation, not
// implemented as an edit to this row (out of scope for the first Этап 2 pass).
model Payment {
  id           String        @id @default(uuid())
  familyId     String
  branchId     String
  amountMinor  Int
  method       PaymentMethod
  paidAt       DateTime
  externalRef  String?
  recordedById String
  createdAt    DateTime      @default(now())

  family Family @relation(fields: [familyId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  allocations PaymentAllocation[]

  @@index([familyId])
  @@map("payment")
}

// Разнесение платежа: one payment can cover several invoices (FIFO), one
// invoice can be covered by several payments. Sum of a payment's allocations
// never exceeds its amountMinor (ТЗ §11.3 invariant #1).
model PaymentAllocation {
  id          String @id @default(uuid())
  paymentId   String
  invoiceId   String
  amountMinor Int

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocation")
}

// ---------------------------------------------------------------------------
// Sales / leads (Этап 3, MVP slice — ТЗ §3)
// ---------------------------------------------------------------------------

model LeadSource {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  leads Lead[]

  @@map("lead_source")
}

model LeadRejectionReason {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  leads Lead[]

  @@map("lead_rejection_reason")
}

enum LeadStage {
  NEW
  CONTACTED
  TOUR_SCHEDULED
  TOUR_DONE
  TRIAL_DAY
  CONTRACT_SIGNING
  ENROLLED
  REJECTED
  WAITLISTED
}

// stageEnteredAt tracks current-stage duration; full stage history is
// reconstructable from AuditLog diffs if/when a funnel-duration report is
// built (ТЗ §3.5) — no dedicated history table for this MVP pass.
model Lead {
  id                     String    @id @default(uuid())
  branchId               String
  parentFullName         String
  parentPhone            String
  parentPhoneNormalized  String // digits-only, computed on write — cross-branch dedup key (ТЗ §3.1)
  parentEmail            String?
  childFullName          String?
  childBirthDate         DateTime?
  targetDate             DateTime?
  sourceId               String?
  stage                  LeadStage @default(NEW)
  stageEnteredAt         DateTime  @default(now())
  rejectionReasonId      String?
  rejectionComment       String?
  responsibleUserId      String
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  convertedFamilyId      String? // set by POST /leads/:id/convert, plain scalar (no relation, matches Discount.approvedById idiom)
  convertedChildId       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  branch          Branch               @relation(fields: [branchId], references: [id])
  source          LeadSource?          @relation(fields: [sourceId], references: [id])
  rejectionReason LeadRejectionReason? @relation(fields: [rejectionReasonId], references: [id])

  activities      LeadActivity[]
  tasks           Task[]
  waitlistEntries WaitlistEntry[]

  @@index([branchId, stage])
  @@index([parentPhoneNormalized])
  @@map("lead")
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activity")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// leadId/familyId are optional and mutually exclusive (app-level check, same
// idiom as Discount.familyId/childId); when both are unset the task is a
// general staff assignment (e.g. branch manager -> teacher/nanny), scoped
// only by branchId. status drives the kanban board; completedAt is kept in
// sync with status so the older OPEN/DONE/OVERDUE-derivation on lead/family
// task widgets keeps working unchanged.
model Task {
  id           String     @id @default(uuid())
  branchId     String
  leadId       String?
  familyId     String?
  description  String
  dueAt        DateTime
  assignedToId String
  status       TaskStatus @default(TODO)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Proof-of-work attachment (photo/document) the assignee submits when the
  // task is done. Auto-deleted REPORT_RETENTION_DAYS after upload by
  // TaskReportCleanupService's daily cron — not kept indefinitely, so
  // reportUploadedAt doubles as the retention clock.
  reportFileKey    String?
  reportFileName   String?
  reportMimeType   String?
  reportUploadedAt DateTime?

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([leadId])
  @@index([familyId])
  @@index([assignedToId])
  @@map("task")
}
