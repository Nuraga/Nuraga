# Compose-level vars for docker-compose.prod.yml (NOT the app's own secrets —
# those go in apps/api/.env, see apps/api/.env.production.example).
#
# Copy to .env.prod on the server and fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Domain the "web" container gets its Let's Encrypt cert for. DNS A-record
# for this domain must already point at the server's public IP before
# `docker compose up`, or the ACME HTTP-01 challenge will fail.
DOMAIN=detsad-crm.ru

POSTGRES_USER=detsad
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
POSTGRES_PASSWORD=
POSTGRES_DB=detsad_crm
